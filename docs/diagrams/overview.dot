// Video Pusher / Video Receiver - system overview.  Render: dot -Tpng -Gdpi=150 overview.dot -o ../images/architecture-overview.png
digraph overview {
    rankdir=LR; nodesep=0.35; ranksep=0.55; pad=0.3;
    fontname="Helvetica"; node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#64748B", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=10, color="#475569", penwidth=1.3];

    src [label="Video file\nor folder of videos", fillcolor="#F1F5F9", shape=folder, style=filled];

    subgraph cluster_vp {
        label=<<b>Video Pusher</b>  (main.py)>; labeljust=l; style="rounded,filled"; fillcolor="#EFF6FF"; color="#3B82F6"; fontsize=12;
        vpg [label="Window\n(Tkinter)"];
        vpw [label="Playlist worker\n(Python thread)"];
        vpf [label="FFmpeg\nfeeder + output", fillcolor="#DBEAFE"];
        vpg -> vpw [dir=both, arrowsize=0.7];
        vpw -> vpf;
    }

    net [label=<<b>Network</b><br/><font point-size="10">SRT · RIST · RTMP/RTMPS · UDP multicast<br/>AES encryption · stream key</font>>, shape=box, style="rounded,filled,dashed", fillcolor="#FEF9C3", color="#CA8A04"];

    subgraph cluster_vr {
        label=<<b>Video Receiver</b>  (receiver.py)>; labeljust=l; style="rounded,filled"; fillcolor="#ECFDF5"; color="#10B981"; fontsize=12;
        vrf [label="FFmpeg / ffplay", fillcolor="#D1FAE5"];
        vrw [label="Receiver worker\n(Python thread)"];
        vrg [label="Window\n(Tkinter)"];
        vrg -> vrw [dir=both, arrowsize=0.7];
        vrw -> vrf;
    }

    out [label="Live picture (ffplay window)\nRecording .ts / .mp4\nMulticast relay", fillcolor="#F1F5F9"];
    ext [label="Third-party receivers\nYouTube · media servers · IRDs · VLC", fillcolor="#F8FAFC", style="rounded,filled,dashed"];

    src -> vpf;
    vpf -> net [penwidth=2.5, color="#2563EB"];
    net -> vrf [penwidth=2.5, color="#059669"];
    vrf -> out;
    net -> ext [style=dashed];
}
